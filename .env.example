TELEGRAM_BOT_TOKEN=
AUTHORIZED_TELEGRAM_USER_ID=
LLM_BASE_URL=
LLM_MODEL=
# Local Chromium profile used only for manual Amazon sign-in and read-only searches.
# Keep this directory outside the repository. It may contain browser-session cookies.
AMAZON_BROWSER_PROFILE_DIR=
# Searches run in the background by default so no window appears on each message.
# Set to false to watch the browser while debugging. Manual sign-in is always visible.
AMAZON_BROWSER_HEADLESS=true
