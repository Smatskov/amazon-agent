TELEGRAM_BOT_TOKEN=
AUTHORIZED_TELEGRAM_USER_ID=
LLM_BASE_URL=
LLM_MODEL=
# Local Chromium profile used only for manual Amazon sign-in and read-only searches.
# Keep this directory outside the repository. It may contain browser-session cookies.
AMAZON_BROWSER_PROFILE_DIR=
# Searches run in the background by default so no window appears on each message.
# Set to false to watch the browser while debugging. Manual sign-in is always visible.
AMAZON_BROWSER_HEADLESS=true

# --- Ordering (spends real money) -------------------------------------------
# Off by default. The agent will refuse to place an order unless this is exactly
# "true", so a stale or copied .env can never spend money by accident.
AMAZON_ENABLE_ORDERING=false
# Hard ceiling on what a single order may cost. Checked against the cart total
# before checkout opens, and again against the total Amazon states on the review
# page — a total that grew between those reads is refused rather than paid.
AMAZON_MAX_ORDER_TOTAL=100
# Append-only record of every order attempt. Defaults to a path outside the repo.
# AMAZON_ORDER_AUDIT_LOG=
